# =============================================================================
# .gitignore | Git + Docker Security Baseline v4 (proposta para revisao)
# Proposito: evitar versionamento acidental de arquivos locais sensiveis.
# Nao protege arquivos ja rastreados e nao impede git add -f.
# Regras de build especificas devem ser habilitadas por projeto.
# =============================================================================

# 1. Ambiente e configuracoes locais
.env
.env.*
*.env
*.env.*
.envrc
.secrets/
secrets.local/
local-secrets/
secrets.json
*.secrets.json

# 2. Chaves e credenciais (PEM pode ser certificado publico: revise excecoes)
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
*.ppk
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
credentials.json
*credentials*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
auth.json
.netrc
.s3cfg
.git-credentials
.npmrc
.pypirc
.dockercfg
**/.docker/config.json

# 3. Credenciais de cloud e infraestrutura como codigo
.aws/
.gcp/
.azure/
.kube/
.ssh/
**/.config/gcloud/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
*.tfplan.*
.terraform/
crash.log
crash.*.log
# PRESERVAR .terraform.lock.hcl quando o projeto utilizar Terraform.

# 4. Estado local de ferramentas de IA e agentes
# Documentos compartilhados (AGENTS.md, CLAUDE.md, regras da equipe)
# podem ser versionados; nao ignorar tudo indiscriminadamente.
CLAUDE.local.md
.claude/settings.local.json
.mcp.json
**/.cursor/mcp.json
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.*

# 5. IDE e sistema operacional
.vscode/*
!.vscode/extensions.json
.idea/
.vs/
.fleet/
.history/
*.suo
*.user
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 6. Caches, logs, arquivos temporarios e dependencias locais
node_modules/
.pnpm-store/
.yarn/cache/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
.nyc_output/
coverage/
test-results/
playwright-report/
TestResults/
*.tsbuildinfo
.cache/
*.log
logs/
*.tmp
*.temp
*.bak
*.bkp
*.orig
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. Dumps e backups
*.sqlite
*.sqlite3
*.db
dump.rdb
*.dump
*.sql.gz
*.sql.zip
*.wpress
# NAO ignorar *.sql: migrations e seeds podem ser codigo-fonte.

# 8. Opcionais por stack - habilitar SOMENTE apos verificar o projeto
# .next/
# .nuxt/
# .turbo/
# dist/
# build/
# out/
# bin/         (Node pode usar bin/www)
# obj/
# target/
# vendor/      (PHP/Go podem depender de vendor)
# public/build/
# wp-content/cache/
# wp-content/ai1wm-backups/

# 9. Excecoes revisadas (somente exemplos sem credenciais)
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template
# Exemplos de excecao, apos revisar conteudo:
# !/certs/ca-publica.pem
# !/.npmrc
